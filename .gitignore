# Workflow-specific directories
results/logs
local_results/

# NOTE: results/<sweep_name> is intentionally NOT ignored here so that jobs run 
# on the cluster can be pushed to Git, pulled to the local machine, and then 
# archived locally via `scratch/archive_results.py`.

