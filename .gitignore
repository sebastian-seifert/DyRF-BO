.idea/
.vscode/
*.swp
*.swo

# Test & cache directories
.pytest_cache/
.ipynb_checkpoints/
runs/
.runs/
.conda/
*.conda
.cache/
benchmarks/

# Log & telemetry files
*.log
dyrf_bo_telemetry.json

# OS-specific files
.DS_Store
Thumbs.db
